<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elite Social Agency</title>

<style>
body {
  margin: 0;
  font-family: Arial;
  background: #0f0f0f;
  color: white;
}

header {
  display: flex;
  justify-content: space-between;
  padding: 20px 40px;
  background: black;
}

header h1 {
  color: #ff4c60;
}

nav a {
  color: white;
  margin-left: 20px;
  text-decoration: none;
}

.hero {
  text-align: center;
  padding: 120px 20px;
}

.hero h2 {
  font-size: 48px;
}

.hero button {
  padding: 12px 25px;
  border: none;
  background: #ff4c60;
  color: white;
  margin-top: 20px;
}

.services {
  padding: 60px;
  text-align: center;
}

.cards {
  display: flex;
  justify-content: center;
  gap: 20px;
}

.card {
  background: #1a1a1a;
  padding: 25px;
  border-radius: 10px;
  width: 250px;
}

.contact {
  text-align: center;
  padding: 60px;
}

.contact input, .contact textarea {
  display: block;
  margin: 10px auto;
  padding: 10px;
  width: 250px;
}

footer {
  text-align: center;
  padding: 20px;
  background: black;
}
</style>

</head>

<body>

<header>
  <h1>Elite Social</h1>
  <nav>
    <a href="#">Home</a>
    <a href="#">Services</a>
    <a href="#">Contact</a>
  </nav>
</header>

<section class="hero">
  <h2>Grow Your Brand 🚀</h2>
  <p>We help you dominate social media</p>
  <button>Get Started</button>
</section>

<section class="services">
  <h2>Our Services</h2>
  <div class="cards">
    <div class="card">
      <h3>Content Creation</h3>
      <p>Reels, posts, branding</p>
    </div>
    <div class="card">
      <h3>Ads Management</h3>
      <p>Facebook & Instagram ads</p>
    </div>
    <div class="card">
      <h3>Growth Strategy</h3>
      <p>Organic followers boost</p>
    </div>
  </div>
</section>

<section class="contact">
  <h2>Contact Us</h2>
  <input placeholder="Your Name">
  <input placeholder="Email">
  <textarea placeholder="Message"></textarea>
</section>

<footer>
  <p>© 2026 Elite Social Agency</p>
</footer>

</body>
</html>